{
  "rules": {
    ".read": false,
    ".write": false,
    "index": {
      "$mode": {
        ".read": "auth != null",
        "$roomId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['state','count','at'])"
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || !newData.exists())"
          }
        },
        "shots": {
          "$sid": { ".write": "auth != null" }
        },
        "hits": {
          "$hid": { ".write": "auth != null" }
        },
        "bots": {
          ".write": "auth != null"
        },
        "bshots": {
          "$bsid": { ".write": "auth != null" }
        },
        "bdmg": {
          "$bdid": { ".write": "auth != null" }
        },
        "events": {
          "$evid": { ".write": "auth != null" }
        },
        "pickups": {
          ".write": "auth != null"
        },
        "builds": {
          ".write": "auth != null"
        },
        "flags": {
          ".write": "auth != null"
        }
      }
    }
  }
}
